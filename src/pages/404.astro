---
// Pagina 404 servita da GitHub Pages per ogni indirizzo inesistente: testi nelle quattro lingue.
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import { withBase } from '../utils/url';
import { localePath, type Lang } from '../i18n/ui';
import badge from '../assets/logo-badge.png';

const messages: { lang: Lang; title: string; text: string; cta: string }[] = [
  { lang: 'it', title: 'Questo disco non è in catalogo', text: 'La pagina che cerchi non esiste o è stata spostata.', cta: 'Torna al sito' },
  { lang: 'en', title: "This record isn't in our crates", text: "The page you're looking for doesn't exist or has moved.", cta: 'Back to the site' },
  { lang: 'sl', title: 'Te plošče ni v naši zbirki', text: 'Stran, ki jo iščete, ne obstaja ali je bila premaknjena.', cta: 'Nazaj na stran' },
  { lang: 'de', title: 'Diese Platte haben wir nicht im Sortiment', text: 'Die gesuchte Seite gibt es nicht oder sie wurde verschoben.', cta: 'Zurück zur Website' },
];
---

<Base lang="it" title="Pagina non trovata – Vinyl Udine" description="Pagina non trovata." path="404" noindex>
  <main class="nf">
    <div class="wrap nf__in">
      <a href={withBase('')} class="nf__logo" aria-label="Vinyl Udine">
        <Image src={badge} width={96} height={96} densities={[1, 2]} alt="" />
      </a>
      <p class="nf__code" aria-label="404">
        <span>4</span><span class="nf__disc" aria-hidden="true"></span><span>4</span>
      </p>
      <div class="nf__msgs">
        {messages.map((m, i) => (
          <section lang={m.lang} class:list={['nf__msg', { 'nf__msg--main': i === 0 }]}>
            {i === 0 ? <h1>{m.title}</h1> : <h2>{m.title}</h2>}
            <p>{m.text}</p>
            <a class:list={['btn', { 'btn--ghost': i > 0 }]} href={withBase(localePath(m.lang))}>{m.cta}</a>
          </section>
        ))}
      </div>
    </div>
  </main>
</Base>

<style>
  .nf { min-height: 100vh; background: var(--yellow); display: grid; align-items: center; padding-block: 48px; }
  .nf__in { display: grid; justify-items: center; text-align: center; gap: 12px; }
  .nf__logo img { width: 96px; height: 96px; }
  .nf__code { display: flex; align-items: center; gap: .08em; margin: 0; font-family: var(--font-display); font-size: clamp(6rem, 22vw, 12rem); line-height: 1; color: var(--ink); }
  .nf__disc {
    width: .82em; height: .82em; border-radius: 50%; position: relative;
    background: radial-gradient(circle, var(--yellow) 0 4%, var(--red) 4.5% 24%, #111 24.5% 26%, #1c1c1c 26.5%);
    box-shadow: inset 0 0 0 2px #000; animation: wobble 2.4s ease-in-out infinite;
  }
  .nf__disc::before { content: ''; position: absolute; inset: 0; border-radius: 50%; background: repeating-radial-gradient(circle, transparent 0 5px, rgb(255 255 255 / .06) 5px 6px); }
  /* la crepa: il disco è "rotto" */
  .nf__disc::after {
    content: ''; position: absolute; left: 50%; top: -4%; width: 10%; height: 50%; transform: translateX(-30%) rotate(18deg);
    background: var(--yellow); clip-path: polygon(40% 0, 100% 0, 55% 35%, 85% 55%, 30% 100%, 45% 60%, 10% 42%);
  }
  @keyframes wobble { 0%, 100% { transform: rotate(-8deg); } 50% { transform: rotate(8deg); } }
  .nf__msgs { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 18px; width: 100%; margin-top: 12px; }
  .nf__msg { background: #fff; border: 2px solid var(--ink); border-radius: var(--radius); padding: 20px; box-shadow: 6px 6px 0 var(--ink); display: grid; gap: 8px; justify-items: center; align-content: start; }
  .nf__msg--main { background: var(--ink); color: #fff; box-shadow: 6px 6px 0 var(--red); }
  .nf__msg--main .btn { background: var(--yellow); color: var(--ink); border-color: var(--yellow); }
  .nf__msg h1, .nf__msg h2 { font-size: 1.35rem; text-transform: uppercase; margin: 0; }
  .nf__msg p { margin: 0 0 6px; }
</style>
